API_HOST=127.0.0.1
API_PORT=8001
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_REVIEWS=100
SCRAPE_TIMEOUT_SECONDS=240
MAX_CONCURRENT_JOBS=1
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_DISABLE_SANDBOX=false
SCRAPER_DEBUG=false
# Jika Google memberi "tampilan terbatas", buat sesi dengan:
# backend\.venv\Scripts\python.exe backend\google_maps_session.py
PLAYWRIGHT_USER_DATA_DIR=.browser-profile
SORT_REVIEWS_NEWEST=true
SENTIMENT_MODEL_ID=mdhugol/indonesia-bert-sentiment-classification
# Isi dengan commit hash model untuk deployment yang sepenuhnya reproducible.
SENTIMENT_MODEL_REVISION=
MODEL_BATCH_SIZE=8
TRANSLATION_MODEL_ID=Helsinki-NLP/opus-mt-id-en
# Optional commit hash for fully reproducible deployment.
TRANSLATION_MODEL_REVISION=
TRANSLATION_BATCH_SIZE=8
# Opsional. Jika kosong, autocomplete gratis memakai Photon/OpenStreetMap dan
# foto terkait (jika tersedia) memakai Wikimedia Commons.
# Jika diisi, simpan key hanya di backend; jangan memakai prefix VITE_.
GOOGLE_MAPS_API_KEY=
PLACES_REGION_CODE=ID
PLACES_LANGUAGE_CODE=id
